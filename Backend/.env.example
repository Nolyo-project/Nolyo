# E-mails via EmailJS (https://www.emailjs.com)
# 1) Créer un service e-mail (Gmail / Outlook…)
# 2) Template — champs EXACTS (sinon 422 « recipients address is corrupted ») :
#      To Email   = {{{to_email}}}   ← TRIPLES accolades (évite l’échappement du @)
#      Reply To   = {{{reply_to}}}
#      Subject    = {{subject}}
#      Content    = {{{html_body}}}
#      From Name  = {{from_name}}
# 3) Account → Security : activer « Allow EmailJS API for non-browser applications »
# 4) Mettre les 4 clés ci-dessous aussi sur Railway (Variables)
MAIL_FROM=Nolyo <bonjour@nolyo.fr>
MAIL_FROM_NAME=Nolyo
# Signature e-mail en HTML (sans image — évite le « ? » cassé sur iPhone)
# Valeurs actuelles (dashboard EmailJS → Test It) :
#   EMAILJS_SERVICE_ID=service_02jgv1q
#   EMAILJS_TEMPLATE_ID=template_aqo6q8b
#   EMAILJS_PUBLIC_KEY=… (Account → General)
#   EMAILJS_PRIVATE_KEY=… (Account → Security, obligatoire pour Node/Railway)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

